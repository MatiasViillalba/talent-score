# Core
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/resume_screening

# Testing: optional, defaults to DATABASE_URL with a "_test" database suffix
TEST_DATABASE_URL=postgresql+asyncpg://app:app@db:5432/resume_screening_test

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
RESUME_PARSER_MODEL=claude-sonnet-4-6

# Stripe
STRIPE_API_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Email (Mailpit in dev)
SMTP_HOST=mailpit
SMTP_PORT=1025

# Business rules
DEFAULT_MONTHLY_CV_QUOTA=100
HIGH_MATCH_THRESHOLD=80
REPORTS_RETENTION_DAYS=30
STORAGE_DIR=storage
CORS_ALLOWED_ORIGINS=http://localhost:3000
